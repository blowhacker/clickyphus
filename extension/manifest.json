{
  "manifest_version": 3,
  "name": "Coordinate Click Companion",
  "version": "0.8.0",
  "description": "Manual and conditional coordinate grid clicks via Chrome DevTools Protocol.",
  "permissions": ["debugger", "activeTab", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Coordinate Click",
    "default_popup": "popup/popup.html"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/picker.js", "content/watcher.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
