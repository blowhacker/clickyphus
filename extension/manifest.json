{
  "manifest_version": 3,
  "name": "Clickyphus",
  "version": "0.10.0",
  "minimum_chrome_version": "138",
  "description": "Let the mouse do the work. Manual clicks and automatic grids triggered by page text or JavaScript rules.",
  "permissions": ["debugger", "activeTab", "storage", "tabs", "userScripts"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clickyphus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/picker.js", "content/watcher.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
