{
  "manifest_version": 3,
  "name": "Coordinate Click Companion",
  "version": "0.6.0",
  "description": "Manual and conditional coordinate grid clicks via Chrome DevTools Protocol.",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Coordinate Click",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "ids": [
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "watcher.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
